# 현재 Supabase 프로젝트의 브라우저 공개 설정은 public/config.js 에 미리 입력되어 있습니다.
# Vercel 빌드 환경변수를 사용하려면 아래 공개 값만 설정하세요.
SUPABASE_URL=https://tunrakwqldpcxrtbdeuq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 절대 추가하지 말 것:
# SUPABASE_SERVICE_ROLE_KEY
# sb_secret_...
# VAPID_PRIVATE_KEY
# PUSH_WEBHOOK_SECRET
# 비밀키는 브라우저에 포함되면 안 됩니다.
